# Copy to .env.local for local development. In production, add these in Vercel:
# Project -> Settings -> Environment Variables, then redeploy.

# Required for the contact form to send email. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where contact messages are delivered. Defaults to the email in data/contact.ts.
# While you're using Resend's shared test sender, this must be the email you signed up to Resend with.
CONTACT_TO_EMAIL=

# Optional. The sender shown in your inbox. Defaults to "TAG Website <onboarding@resend.dev>".
# To send from your own domain, verify it in Resend first, e.g. "TAG <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
